# Copy to /etc/jellyfin-home-curator.env (chmod 600) and fill in.
JELLYFIN_URL=http://localhost:8096
# Dashboard -> API Keys -> +, name it home-curator
JELLYFIN_API_KEY=<JELLYFIN_API_KEY>
# Username that owns the Featured playlist (an admin is simplest)
PLAYLIST_OWNER=<USER_1>
PLAYLIST_NAME=Featured
TRENDING_COLLECTION=Trending Now
